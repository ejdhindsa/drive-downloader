{
  "name": "drive-downloader",
  "version": "1.0.0",
  "description": "Self-hosted URL-to-Google-Drive downloader with aria2c, archive auto-extraction, and rclone streaming",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "@fastify/static": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
