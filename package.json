{
  "name": "drive-downloader",
  "version": "1.0.0",
  "description": "Self-hosted URL-to-Google-Drive downloader with aria2c, archive auto-extraction, and rclone streaming",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
