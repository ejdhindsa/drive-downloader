# Host user/group IDs (run `id` on your server to verify)
PUID=1000
PGID=1000

# Container timezone
TZ=UTC

# rclone settings
RCLONE_ROOT=gdrive:Media
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_HOST_CONFIG_DIR=/path/to/.config/rclone

# Queue & staging settings
MAX_CONCURRENT_JOBS=2
MIN_FREE_DISK_GB=15
MAX_EXTRACT_SIZE_GB=50
STAGING_DIR=/tmp/staging
DATA_DIR=/app/data

# Optional: HTTP/HTTPS proxy for outbound downloads & URL probes (e.g. http://gluetun:8888)
# Note: Applied to aria2c, yt-dlp, URL redirect validation, and rclone copyurl (not rclone move/lsf).
DOWNLOAD_PROXY=

# Optional: Media library & VFS refresh targets
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
RCLONE_RC_URL=
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_API_KEY=
AUDIOBOOKSHELF_LIBRARY_ID=
POST_UPLOAD_WEBHOOK_URL=

# Optional: Inactivity-gated completion/failure notifications
# Suppresses browser & webhook notifications if you were active in the tab within this window (0 disables gating).
NOTIFY_INACTIVE_SECONDS=300
DISCORD_WEBHOOK_URL=
NTFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
