# Host user/group IDs (run `id` on your server to verify)
PUID=1000
PGID=1000

# Container timezone
TZ=UTC

# rclone settings
RCLONE_ROOT=gdrive:Media
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_HOST_CONFIG_DIR=/path/to/.config/rclone

# Queue & staging settings
MAX_CONCURRENT_JOBS=2
MIN_FREE_DISK_GB=15
MAX_EXTRACT_SIZE_GB=50
STAGING_DIR=/tmp/staging
DATA_DIR=/app/data

# Optional: HTTP/HTTPS proxy for outbound downloads & URL probes (e.g. http://gluetun:8888)
# Note: Applied to aria2c, URL redirect validation, and rclone copyurl (not rclone move/lsf).
DOWNLOAD_PROXY=

# Optional: Jellyfin library refresh (container is on the `edge` network with jellyfin)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Optional: Host rclone RC endpoint if rclone-gdrive.service enables --rc
# e.g. http://172.17.0.1:5572 or http://host.docker.internal:5572
RCLONE_RC_URL=
